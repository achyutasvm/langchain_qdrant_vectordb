OPENAI_API_KEY=

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=10k_filing

OPENAI_MODEL=gpt-4o-mini

DOCS_DIR=docs
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=8

CORS_ORIGINS=http://localhost:3000

# Reranking (local fastembed cross-encoder; downloaded on first use)
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-12-v2
RERANK_CANDIDATES=20
# hf-xet 1.6.0 can fail model downloads with "Byte range not sequential";
# this forces plain HTTP downloads from Hugging Face instead.
HF_HUB_DISABLE_XET=1
